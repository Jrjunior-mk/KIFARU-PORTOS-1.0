# KIFARU PORTOS API — environment configuration example. Copy to .env for local development.
# NEVER commit real secrets. In AWS these values are injected from Secrets Manager / SSM by the ECS task definition.

KIFARU_ENV=dev                       # dev | test | staging | prod
KIFARU_LOG_LEVEL=INFO

# Database: SQLite for quick local runs; PostgreSQL for everything else
KIFARU_DATABASE_URL=sqlite:///./kifaru_dev.db
# KIFARU_DATABASE_URL=postgresql+psycopg://kifaru:kifaru_dev@localhost:5432/kifaru
# Supabase (project KIFARU-PORTOS, ref myftjzmpshjoopgfibzp) — copy the URI from Dashboard > Connect and prefix the
# driver. Session pooler (IPv4, long-lived processes such as uvicorn / workers):
# KIFARU_DATABASE_URL=postgresql+psycopg://postgres.myftjzmpshjoopgfibzp:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Transaction pooler (serverless, e.g. Vercel):
# KIFARU_DATABASE_URL=postgresql+psycopg://postgres.myftjzmpshjoopgfibzp:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# The driver detects *.supabase.com and sets sslmode=require and pooler-safe prepared statements; or force them:
# KIFARU_DB_REQUIRE_SSL=true
# KIFARU_DB_POOLER_TRANSACTION_MODE=true
# Helper that tests the connection, runs migrations, seeds and writes this file: python scripts/connect_supabase.py --url "<URI>"

# Redis (required when running more than one API instance; enables cross-instance WebSocket fan-out)
# KIFARU_REDIS_URL=redis://localhost:6379/0

# MQTT ingest (EMQX locally; AWS IoT Core endpoint in the cloud, mTLS)
# KIFARU_MQTT_HOST=localhost
# KIFARU_MQTT_PORT=8883
# KIFARU_MQTT_TLS_CA=/certs/AmazonRootCA1.pem
# KIFARU_MQTT_TLS_CERT=/certs/ingest.pem.crt
# KIFARU_MQTT_TLS_KEY=/certs/ingest.pem.key

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KIFARU_JWT_SECRET=CHANGE-ME-dev-only-secret-not-for-production
KIFARU_ACCESS_TOKEN_MINUTES=15
KIFARU_REFRESH_TOKEN_DAYS=14

# Ed25519 signing seed (base64, 32 bytes) — generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Required in staging/prod. In dev a deterministic key is derived from the JWT secret.
# KIFARU_SIGNING_SEED_B64=
KIFARU_SIGNING_KEY_ID=platform-dev-key

# Object storage
# KIFARU_S3_BUCKET=kifaru-prod-objects
KIFARU_S3_REGION=af-south-1
KIFARU_LOCAL_OBJECT_DIR=./objects

# Clearance engine
KIFARU_LIMITS_VERSION=KE-EAC-VLC-REG-2018-schedule-v2
KIFARU_AUDIT_SAMPLE_RATE=0.02
KIFARU_IDENTITY_MIN_CONFIDENCE=0.90

# Frontend origin(s) and public URL used inside QR codes
KIFARU_CORS_ORIGINS=["http://localhost:5173"]
KIFARU_PUBLIC_BASE_URL=http://localhost:5173

# External adapters (real mode only; leave unset for mock mode)
# KIFARU_AT_USERNAME=sandbox
# KIFARU_AT_API_KEY=
# KIFARU_INT_KENHA_TOKEN=
# KIFARU_INT_KRA_TOKEN=
# KIFARU_INT_NTSA_TOKEN=
